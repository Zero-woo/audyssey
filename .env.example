# Copy to .env and replace the token. Never commit .env.
AUDYSSEY_TOOL_TOKEN=replace-with-a-random-token
# Official gated models: request access on Hugging Face, then download into HF_CACHE (README 2.7).
AUDYSSEY_SAM_AUDIO_MODEL=facebook/sam-audio-large-tv
AUDYSSEY_SAM3_MODEL=facebook/sam3.1
AUDYSSEY_SAM_AUDIO_JUDGE_MODEL=facebook/sam-audio-judge
HF_CACHE=/home/common/huggingface
# Image tag for main and the tool servers: a commit SHA from publish-images (empty = latest).
# Pin a checked SHA on shared servers (docs/contributing.md).
AUDYSSEY_IMAGE_TAG=
# GPU index per tool server (same index = share one GPU).
AUDYSSEY_SEPARATION_GPU=0
AUDYSSEY_JUDGE_GPU=0
AUDYSSEY_GROUNDING_GPU=0
AUDYSSEY_GENERATION_GPU=0
# Laptop + RunPod: separation, filtering and grounding share one Pod endpoint.
# Generation requires a separate environment; the current RunPod setup does not include it.
# AUDYSSEY_GENERATOR=stub
# AUDYSSEY_SEPARATOR_URL=https://your-pod-8700.proxy.runpod.net
# AUDYSSEY_FILTER_URL=https://your-pod-8700.proxy.runpod.net
# AUDYSSEY_GROUNDING_URL=https://your-pod-8700.proxy.runpod.net

# Local vLLM planner (cache must already contain this model and its processor).
AUDYSSEY_VLLM_MODEL=Qwen/Qwen2.5-VL-3B-Instruct
AUDYSSEY_VLLM_GPU=0
# Fraction of the vLLM GPU's memory. 0.2 leaves room for the tools (generation memory measurement pending) on one 80GB GPU;
# raise it (e.g. 0.85) when vLLM has a GPU of its own.
AUDYSSEY_VLLM_GPU_UTIL=0.2
# Gemini with video input (Google SDK, Files API upload) instead of the default local vLLM endpoint.
# AUDYSSEY_PLANNER_API=gemini
# AUDYSSEY_PLANNER_INPUT=video
# AUDYSSEY_PLANNER_MODEL=gemini-3.5-flash-lite
# AUDYSSEY_PLANNER_FPS=1
# AUDYSSEY_PLANNER_VIDEO_AUDIO=true
# Or Gemini through OpenRouter (OpenRouter key in AUDYSSEY_PLANNER_API_KEY; fps is the model default).
# AUDYSSEY_PLANNER_API=openrouter
# AUDYSSEY_PLANNER_BASE_URL=https://openrouter.ai/api/v1
# AUDYSSEY_PLANNER_MODEL=google/gemini-3.5-flash-lite
# AUDYSSEY_PLANNER_INPUT=video
# AUDYSSEY_PLANNER_VIDEO_AUDIO=true
# Validator model; unset values fall back to the planner's (docs/running.md#플래너-연결-gemini-vllm).
# AUDYSSEY_VALIDATOR_API=openai
# AUDYSSEY_VALIDATOR_BASE_URL=http://validator-vllm:8000/v1
# AUDYSSEY_VALIDATOR_MODEL=Qwen/Qwen2.5-Omni-3B
# AUDYSSEY_VALIDATOR_API_KEY=unused
# AUDYSSEY_VALIDATOR_INPUT=video
# AUDYSSEY_VALIDATOR_VIDEO_AUDIO=true
# Inject GOOGLE_API_KEY privately; Compose forwards it as AUDYSSEY_PLANNER_API_KEY.
